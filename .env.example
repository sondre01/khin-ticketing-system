# Database Configuration
# Format: postgresql://postgres.[project-ref]:[password]@pooler-host:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.[your-project-ref]:[your-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Security
# Run: openssl rand -hex 32  (or any long random string)
JWT_SECRET=super_secret_unbreakable_key_change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Config
HOST=127.0.0.1
PORT=5000

# Gmail Ingestion (IMAP) & Email Verification (SMTP with Google App Password)
# To get an App Password: Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_USER=gamboa.khinandrei@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
OTP_EXPIRE_MINUTES=10
